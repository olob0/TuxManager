<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>CpuDetailWidget</class>
 <widget class="QWidget" name="CpuDetailWidget">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>900</width><height>560</height></rect>
  </property>
  <layout class="QVBoxLayout" name="verticalLayout">

   <!-- Header: title, model name and the graph mode switch (added at runtime) -->
   <item>
    <layout class="QHBoxLayout" name="headerLayout">
     <item>
      <layout class="QVBoxLayout" name="headerLabelLayout">
       <property name="spacing"><number>2</number></property>
       <item>
        <widget class="QLabel" name="titleLabel">
         <property name="text"><string>CPU</string></property>
        </widget>
       </item>
       <item>
        <widget class="QLabel" name="modelNameLabel">
         <property name="text"><string notr="true"></string></property>
        </widget>
       </item>
      </layout>
     </item>
     <item>
      <spacer name="headerSpacer">
       <property name="orientation"><enum>Qt::Horizontal</enum></property>
       <property name="sizeHint" stdset="0"><size><width>40</width><height>0</height></size></property>
      </spacer>
     </item>
    </layout>
   </item>

   <!-- Body: graph column + statistics -->
   <item>
    <layout class="QHBoxLayout" name="bodyLayout">
     <item>
      <layout class="QVBoxLayout" name="graphColumn">
       <item>
        <widget class="Perf::GraphCard" name="graphCard">
         <layout class="QVBoxLayout" name="graphCardLayout">
          <item>
           <layout class="QHBoxLayout" name="graphHeaderLayout">
            <item>
             <widget class="QLabel" name="graphTitleLabel">
              <property name="text"><string>Utilization</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="graphMaxLabel">
              <property name="text"><string notr="true">100%</string></property>
             </widget>
            </item>
           </layout>
          </item>
          <item>
           <!-- CpuGraphArea is inserted here at runtime -->
           <widget class="QWidget" name="graphAreaContainer">
            <property name="minimumHeight"><number>120</number></property>
            <property name="sizePolicy">
             <sizepolicy hsizetype="Expanding" vsizetype="Expanding">
              <horstretch>0</horstretch>
              <verstretch>1</verstretch>
             </sizepolicy>
            </property>
           </widget>
          </item>
          <item>
           <layout class="QHBoxLayout" name="timeAxisLayout">
            <item>
             <widget class="QLabel" name="timeLeftLabel">
              <property name="text"><string>60 seconds</string></property>
             </widget>
            </item>
            <item>
             <widget class="QLabel" name="timeRightLabel">
              <property name="text"><string>0</string></property>
             </widget>
            </item>
           </layout>
          </item>
         </layout>
        </widget>
       </item>
      </layout>
     </item>
     <item>
      <!-- Labels are handed to the panel in display order by CpuDetailWidget -->
      <widget class="Perf::StatsPanel" name="statsPanel">
       <widget class="QLabel" name="statUtilLabel"><property name="text"><string>Utilization</string></property></widget>
       <widget class="QLabel" name="statUtilValue"><property name="text"><string>0%</string></property></widget>
       <widget class="QLabel" name="statSpeedLabel"><property name="text"><string>Speed</string></property></widget>
       <widget class="QLabel" name="statSpeedValue"><property name="text"><string>—</string></property></widget>
       <widget class="QLabel" name="statProcessesLabel"><property name="text"><string>Processes</string></property></widget>
       <widget class="QLabel" name="statProcessesValue"><property name="text"><string>—</string></property></widget>
       <widget class="QLabel" name="statThreadsLabel"><property name="text"><string>Threads</string></property></widget>
       <widget class="QLabel" name="statThreadsValue"><property name="text"><string>—</string></property></widget>
       <widget class="QLabel" name="statTempLabel"><property name="text"><string>Temperature</string></property></widget>
       <widget class="QLabel" name="statTempValue"><property name="text"><string>—</string></property></widget>
       <widget class="QLabel" name="statUptimeLabel"><property name="text"><string>Uptime</string></property></widget>
       <widget class="QLabel" name="statUptimeValue"><property name="text"><string>—</string></property></widget>
       <widget class="QLabel" name="statLogicalCpusLabel"><property name="text"><string>Logical processors</string></property></widget>
       <widget class="QLabel" name="statLogicalCpusValue"><property name="text"><string>—</string></property></widget>
       <widget class="QLabel" name="statVmLabel"><property name="text"><string>Virtual machine</string></property></widget>
       <widget class="QLabel" name="statVmValue"><property name="text"><string>—</string></property></widget>
      </widget>
     </item>
    </layout>
   </item>

  </layout>
 </widget>
 <customwidgets>
  <customwidget>
   <class>Perf::GraphCard</class>
   <extends>QFrame</extends>
   <header>perf/graphcard.h</header>
   <container>1</container>
  </customwidget>
  <customwidget>
   <class>Perf::StatsPanel</class>
   <extends>QFrame</extends>
   <header>perf/statspanel.h</header>
   <container>1</container>
  </customwidget>
 </customwidgets>
 <resources/>
 <connections/>
