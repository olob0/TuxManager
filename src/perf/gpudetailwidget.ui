<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>GpuDetailWidget</class>
 <widget class="QWidget" name="GpuDetailWidget">
  <property name="geometry"><rect><x>0</x><y>0</y><width>900</width><height>560</height></rect></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <!-- Header -->
   <item>
    <layout class="QHBoxLayout" name="headerLayout">
     <item><layout class="QVBoxLayout" name="headerLabelLayout"><property name="spacing"><number>2</number></property><item><widget class="QLabel" name="titleLabel"><property name="text"><string>GPU</string></property></widget></item><item><widget class="QLabel" name="modelLabel"><property name="text"><string notr="true"></string></property></widget></item></layout></item>
    </layout>
   </item>
   <!-- Body: graph column + statistics -->
   <item>
    <layout class="QHBoxLayout" name="bodyLayout">
     <item>
      <layout class="QVBoxLayout" name="graphColumn">
       <!-- Overview: utilization and memory; GpuDetailWidget puts them side by side on wide pages -->
       <item>
<layout class="QHBoxLayout" name="overviewLayout">
<item>
<widget class="Perf::GraphCard" name="utilizationCard">
 <property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>3</verstretch></sizepolicy></property>
 <layout class="QVBoxLayout" name="utilizationCardLayout">
  <item><layout class="QHBoxLayout" name="utilizationCardHeaderLayout"><item><widget class="QLabel" name="utilGraphLabel"><property name="text"><string>Utilization</string></property></widget></item><item><widget class="QLabel" name="utilGraphMaxLabel"><property name="text"><string notr="true">100%</string></property></widget></item></layout></item>
  <item><widget class="Perf::GraphWidget" name="utilGraphWidget" native="true"><property name="minimumHeight"><number>72</number></property><property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy></property></widget></item>
  <item><layout class="QHBoxLayout" name="utilizationCardAxisLayout"><item><widget class="QLabel" name="utilTimeLeftLabel"><property name="text"><string>60 seconds</string></property></widget></item><item><widget class="QLabel" name="utilTimeRightLabel"><property name="text"><string>0</string></property></widget></item></layout></item>
 </layout>
</widget>
</item>
<item>
<layout class="QVBoxLayout" name="memoryLayout">
<item>
<widget class="Perf::GraphCard" name="dedicatedCard">
 <property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>2</verstretch></sizepolicy></property>
 <layout class="QVBoxLayout" name="dedicatedCardLayout">
  <item><layout class="QHBoxLayout" name="dedicatedCardHeaderLayout"><item><widget class="QLabel" name="dedicatedMemGraphLabel"><property name="text"><string>Dedicated GPU memory usage</string></property></widget></item><item><widget class="QLabel" name="dedicatedMemGraphMaxLabel"><property name="text"><string>0 GB</string></property></widget></item></layout></item>
  <item><widget class="Perf::GraphWidget" name="dedicatedMemGraphWidget" native="true"><property name="minimumHeight"><number>72</number></property><property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy></property></widget></item>
  <item><layout class="QHBoxLayout" name="dedicatedCardAxisLayout"><item><widget class="QLabel" name="dedicatedTimeLeftLabel"><property name="text"><string>60 seconds</string></property></widget></item><item><widget class="QLabel" name="dedicatedTimeRightLabel"><property name="text"><string>0</string></property></widget></item></layout></item>
 </layout>
</widget>
</item>
<item>
<widget class="Perf::GraphCard" name="sharedCard">
 <property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>2</verstretch></sizepolicy></property>
 <layout class="QVBoxLayout" name="sharedCardLayout">
  <item><layout class="QHBoxLayout" name="sharedCardHeaderLayout"><item><widget class="QLabel" name="sharedMemGraphLabel"><property name="text"><string>Shared GPU memory usage</string></property></widget></item><item><widget class="QLabel" name="sharedMemGraphMaxLabel"><property name="text"><string>0 GB</string></property></widget></item></layout></item>
  <item><widget class="Perf::GraphWidget" name="sharedMemGraphWidget" native="true"><property name="minimumHeight"><number>72</number></property><property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy></property></widget></item>
  <item><layout class="QHBoxLayout" name="sharedCardAxisLayout"><item><widget class="QLabel" name="sharedTimeLeftLabel"><property name="text"><string>60 seconds</string></property></widget></item><item><widget class="QLabel" name="sharedTimeRightLabel"><property name="text"><string>0</string></property></widget></item></layout></item>
 </layout>
</widget>
</item>
</layout>
</item>
</layout>
       </item>
       <!-- Engines and copy bandwidth -->
       <item>
<widget class="QWidget" name="engineAreaContainer"><property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Maximum"><horstretch>0</horstretch><verstretch>0</verstretch></sizepolicy></property></widget>
       </item>
       <item>
<widget class="Perf::GraphCard" name="copyCard">
 <property name="sizePolicy"><sizepolicy hsizetype="Preferred" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>2</verstretch></sizepolicy></property>
 <layout class="QVBoxLayout" name="copyCardLayout">
  <item><layout class="QHBoxLayout" name="copyCardHeaderLayout"><item><widget class="QLabel" name="copyBwGraphLabel"><property name="text"><string>Copy bandwidth</string></property></widget></item><item><widget class="QLabel" name="copyBwGraphMaxLabel"><property name="text"><string>0 KB/s</string></property></widget></item></layout></item>
  <item><widget class="Perf::GraphWidget" name="copyBwGraphWidget" native="true"><property name="minimumHeight"><number>72</number></property><property name="sizePolicy"><sizepolicy hsizetype="Expanding" vsizetype="Expanding"><horstretch>0</horstretch><verstretch>1</verstretch></sizepolicy></property></widget></item>
  <item><layout class="QHBoxLayout" name="copyCardAxisLayout"><item><widget class="QLabel" name="copyTimeLeftLabel"><property name="text"><string>60 seconds</string></property></widget></item><item><widget class="QLabel" name="copyTimeRightLabel"><property name="text"><string>0</string></property></widget></item></layout></item>
 </layout>
</widget>
       </item>
      </layout>
     </item>
     <item>
      <!-- Labels are handed to the panel in display order by GpuDetailWidget -->
      <widget class="Perf::StatsPanel" name="statsPanel">
       <widget class="QLabel" name="utilLabel"><property name="text"><string>Utilization</string></property></widget>
       <widget class="QLabel" name="utilValueLabel"><property name="text"><string>0%</string></property></widget>
       <widget class="QLabel" name="tempLabel"><property name="text"><string>Temperature</string></property></widget>
       <widget class="QLabel" name="tempValueLabel"><property name="text"><string>—</string></property></widget>
       <widget class="QLabel" name="coreClockLabel"><property name="text"><string>Core clock</string></property></widget>
       <widget class="QLabel" name="coreClockValueLabel"><property name="text"><string>—</string></property></widget>
       <widget class="QLabel" name="powerUsageLabel"><property name="text"><string>Power usage</string></property></widget>
       <widget class="QLabel" name="powerUsageValueLabel"><property name="text"><string>—</string></property></widget>
       <widget class="QLabel" name="dedicatedMemLabel"><property name="text"><string>Dedicated GPU memory</string></property></widget>
       <widget class="QLabel" name="dedicatedMemValueLabel"><property name="text"><string>0 / 0 GB</string></property></widget>
       <widget class="QLabel" name="sharedMemLabel"><property name="text"><string>Shared GPU memory</string></property></widget>
       <widget class="QLabel" name="sharedMemValueLabel"><property name="text"><string>0 / 0 GB</string></property></widget>
       <widget class="QLabel" name="gpuMemLabel"><property name="text"><string>Total GPU memory</string></property></widget>
       <widget class="QLabel" name="gpuMemValueLabel"><property name="text"><string>0 / 0 GB</string></property></widget>
       <widget class="QLabel" name="driverLabel"><property name="text"><string>Driver version</string></property></widget>
       <widget class="QLabel" name="driverValueLabel"><property name="text"><string>—</string></property></widget>
       <widget class="QLabel" name="backendLabel"><property name="text"><string>Backend</string></property></widget>
       <widget class="QLabel" name="backendValueLabel"><property name="text"><string>—</string></property></widget>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
